# Where exports come from: "local" (a directory) or "sftp" (e.g. your Common App SDS drop)
COMMONAPP_SOURCE=sftp
COMMONAPP_FILE_PATTERN=*.txt

COMMONAPP_LOCAL_DIR=./inbox

COMMONAPP_SFTP_HOST=
COMMONAPP_SFTP_PORT=22
COMMONAPP_SFTP_USER=
COMMONAPP_SFTP_KEY_PATH=
COMMONAPP_SFTP_PASSWORD=
COMMONAPP_SFTP_REMOTE_DIR=/
COMMONAPP_SFTP_KNOWN_HOSTS=

# Optional overrides for column headers -> fields
COMMONAPP_FIELD_MAP=./examples/field_map.json
COMMONAPP_STATE_PATH=./.state/commonapp.json
COMMONAPP_DB_PATH=./.state/applications.db

# Sinks (configure one or more)
COMMONAPP_JSONL_PATH=./output/applications.jsonl
COMMONAPP_CSV_DIR=
COMMONAPP_WEBHOOK_URL=
COMMONAPP_WEBHOOK_TOKEN=

# Required when serving over HTTP on anything but localhost
COMMONAPP_MCP_TOKEN=
